# ─────────────────────────────────────────────────────────────────────────────
# BookFlow configuration. Copy to .env and fill in. Lines starting with # are
# comments. The server validates this at startup and refuses unsafe settings.
# Check without starting:  docker compose run --rm app node dist-server/cli.mjs check-config
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Your domain (used by Caddy for HTTPS) and the public origin of the app.
DOMAIN=book.example.com
PUBLIC_BASE_URL=https://book.example.com
# Email for Let's Encrypt expiry notices (optional but recommended).
ACME_EMAIL=you@example.com

# Who operates this service (shown on /privacy and /terms — have those pages reviewed).
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ADDRESS=

# ── Messaging (without these, messages on that channel fail — they are never faked in production)
# SMS + WhatsApp via Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a Messaging Service (recommended) or a single sender number:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
# WhatsApp-enabled sender in E.164, e.g. +14155238886 (enables the WhatsApp channel)
TWILIO_WHATSAPP_FROM=
# In Twilio, set the "A message comes in" webhook of your number / service to:
#   https://<DOMAIN>/api/webhooks/twilio/inbound   (STOP/START handling)
# Delivery statuses are requested per message automatically (…/api/webhooks/twilio/status).

# Email via Resend (https://resend.com): password resets, invitations, confirmations
RESEND_API_KEY=
# A sender on a domain you verified in Resend
EMAIL_FROM=BookFlow <bookings@mail.example.com>
EMAIL_REPLY_TO=
# Resend → Webhooks → endpoint https://<DOMAIN>/api/webhooks/resend (events: delivered, bounced, complained)
RESEND_WEBHOOK_SECRET=

# ── Billing (optional). Leave empty for a free pilot: every business gets full access.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://<DOMAIN>/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=
# Recurring prices you created in Stripe for the Solo and Team plans
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
TRIAL_DAYS=14
# Prices shown on the landing page (monthly, whole units) — keep them equal to your Stripe prices.
# Leave PRICE_CURRENCY empty to show "Free during early access".
PRICE_CURRENCY=
PRICE_SOLO=
PRICE_TEAM=
PRICE_BUSINESS=

# ── Operations ───────────────────────────────────────────────────────────────
# Automatic online backups inside the data volume (hours between backups, how many to keep).
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28
# Bearer token for https://<DOMAIN>/api/metrics (Prometheus format). Empty = disabled.
METRICS_TOKEN=
# Optional: POST {"text": …} error alerts here (Slack/Discord/Teams incoming webhook).
ERROR_WEBHOOK_URL=
# json (production default) or pretty
LOG_FORMAT=json

# ── Rarely changed ───────────────────────────────────────────────────────────
# Demo mode seeds two sample businesses and a one-click demo login. Keep OFF for real customers.
BOOKFLOW_DEMO=0
# Set only together with BOOKFLOW_DEMO=1 on a public demo server.
BOOKFLOW_DEMO_PASSWORD=
# Simulate channels that have no provider (demo servers only).
MESSAGING_SIMULATE=0
# PORT=8787
# DATABASE_PATH=/data/bookflow.sqlite
# UPLOAD_DIR=/data/uploads
# BACKUP_DIR=/data/backups
